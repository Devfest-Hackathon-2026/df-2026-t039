# アプリDB
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB
POSTGRES_USER
POSTGRES_PASSWORD

# 認証
FIREBASE_PROJECT_ID

# Vertex AI
GOOGLE_GENAI_USE_ENTERPRISE
GOOGLE_CLOUD_PROJECT
GOOGLE_CLOUD_LOCATION
GEMINI_MODEL
ADK_DATABASE_URL=postgres://user:password@127.0.0.1:5432/adk_sessions

# 場所検索
GOOGLE_PLACES_API_KEY

# その他
CORS_ORIGINS
DEMO_PORT=8081

# デプロイ
GCP_PROJECT_ID

# ローカル開発専用（npm run dev）。両方を設定すると、DEV_AUTH_TOKEN を Bearer に付けたリクエストを
# DEV_AUTH_USER_ID のユーザーとして扱う。NODE_ENV=production や Cloud Run 上では起動しない。
# DEV_AUTH_USER_ID=local-api-demo-user
# DEV_AUTH_TOKEN=16文字以上のランダムな文字列（例: openssl rand -hex 24）
